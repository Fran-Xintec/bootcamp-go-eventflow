# Copiar a .env para cambiar algo (es opcional: docker compose ya trae estos valores por defecto).
# Son valores de ejemplo para desarrollo local, no hay secretos reales.
ENVIRONMENT=dev
PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=eventflow
DB_PASSWORD=eventflow
DB_NAME=eventflow
DB_SSL_MODE=disable

# RabbitMQ (usuario y clave de ejemplo del broker local)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Espera de la notificación simulada que hace el worker, en milisegundos
NOTIFY_DELAY_MS=200

# Plazo máximo para atender una petición (base de datos incluida), en milisegundos
REQUEST_TIMEOUT_MS=5000

# Plazo de apagado ordenado, en segundos
SHUTDOWN_TIMEOUT=10
